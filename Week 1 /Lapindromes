import java.io.*;
import java.util.*;
import java.util.stream.*;
import java.util.function.*;

public class Lapindrome
{

    static final Function<String, String> checkLapindrome = s -> 
{
        int n = s.length();
        int half = n / 2;

        String firstHalf = s.substring(0, half);
        String secondHalf = s.substring(n - half);

        Map<Character, Long> freq1 = firstHalf.chars()
                .mapToObj(c -> (char) c)
                .collect(Collectors.groupingBy(Function.identity(), Collectors.counting()));

        Map<Character, Long> freq2 = secondHalf.chars()
                .mapToObj(c -> (char) c)
                .collect(Collectors.groupingBy(Function.identity(), Collectors.counting()));

        return freq1.equals(freq2) ? "YES" : "NO";
    };

    public static void main(String[] args) throws IOException
{
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int t = Integer.parseInt(br.readLine().trim());

        List<String> results = IntStream.range(0, t)
                .mapToObj(i -> 
{
                    try {
                        return br.readLine().trim();
                    } catch (IOException e)
{
                        throw new UncheckedIOException(e);
                    }
                })
                .map(checkLapindrome)
                .collect(Collectors.toList());

        results.forEach(System.out::println);
    }
}



